{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // The published artifact is bundled by tsup, so internal relative imports are
    // resolved at build time and stay extensionless. Consumer-facing resolution
    // (node10 / node16 / bundler) is validated separately against the packed
    // tarball by `attw --pack` and the compile-only fixtures in test/types.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "*.config.ts"]
}
